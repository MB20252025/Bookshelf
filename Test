<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bookshelf – All Books</title>
  <style>
    * {
      margin: 0;
      padding: 0;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: auto;   /* scroll if books go off-screen */
    }

    /* ---------- BACKGROUND (EDIT IMAGE PATH) ---------- */
    .scene {
      position: relative;
      width: 100vw;
      min-height: 100vh;
      background-image: url('sbackground.jpg');  /* <-- EDIT: background file */
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      padding: 20px 0;   /* some breathing room */
      box-sizing: border-box;
    }

    /* ---------- EACH BOOK ---------- */
    .book {
      position: absolute;
      transform-origin: top left;
      /* images keep aspect ratio automatically */
    }
  </style>
</head>
<body>
  <div class="scene" id="bookshelf">
    <!-- Books will be injected here by JavaScript -->
  </div>

  <script>
    // ================================================================
    //  📚  EDIT YOUR BOOKS HERE – POSITION (x, y) & SCALE
    // ================================================================
    // Each entry: { src: "filename.png", x: 50, y: 100, scale: 0.8 }
    //  - x = distance from left edge (px)
    //  - y = distance from top edge (px)
    //  - scale = 1.0 = original size, 0.5 = half, 2.0 = double
    // ================================================================

    const booksData = [
      // ---- Row 1 (y ~ 80) ----
      { src: "book1.png",  x: 10,  y: 30,  scale: 0.25 },
      { src: "book2.png",  x: 26,  y: 31,  scale: 0.25 },
      { src: "book3.png",  x: 35, y: 32,  scale: 0.25 },
      { src: "book4.png",  x: 50, y: 33,  scale: 0.25 },
      { src: "book5.png",  x: 65, y: 34,  scale: 0.25 },
      { src: "book6.png",  x: 80, y: 40,  scale: 0.25 },
      { src: "book7.png",  x: 95, y: 60,  scale: 0.25 },
      { src: "book8.png",  x: 110, y: 80,  scale: 0.25 },
      { src: "book9.png",  x: 125, y: 80,  scale: 0.25 },
      { src: "book10.png", x: 140, y: 80,  scale: 0.25 },
      { src: "book11.png", x: 155, y: 80,  scale: 0.25 },

      // ---- Row 2 (y ~ 200) ----
      { src: "book12.png", x: 20,  y: 200, scale: 0.25 },
      { src: "book13.png", x: 90,  y: 200, scale: 0.25 },
      { src: "book14.png", x: 160, y: 200, scale: 0.25 },
      { src: "book15.png", x: 230, y: 200, scale: 0.25 },
      { src: "book16.png", x: 300, y: 200, scale: 0.25 },
      { src: "book17.png", x: 370, y: 200, scale: 0.25 },
      { src: "book18.png", x: 440, y: 200, scale: 0.25 },
      { src: "book19.png", x: 510, y: 200, scale: 0.25 },
      { src: "book20.png", x: 580, y: 200, scale: 0.25 },
      { src: "book21.png", x: 650, y: 200, scale: 0.25 },
      { src: "book22.png", x: 720, y: 200, scale: 0.25 },

      // ---- Row 3 (y ~ 320) ----
      { src: "book23.png", x: 20,  y: 320, scale: 0.25 },
      { src: "book24.png", x: 90,  y: 320, scale: 0.25 },
      { src: "book25.png", x: 160, y: 320, scale: 0.25 },
      { src: "book26.png", x: 230, y: 320, scale: 0.25 },
      { src: "book27.png", x: 300, y: 320, scale: 0.25 },
      { src: "book28.png", x: 370, y: 320, scale: 0.25 },
      { src: "book29.png", x: 440, y: 320, scale: 0.25 },
      { src: "book30.png", x: 510, y: 320, scale: 0.25 },
      { src: "book31.png", x: 580, y: 320, scale: 0.25 },
      { src: "book32.png", x: 650, y: 320, scale: 0.25 },
      { src: "book33.png", x: 720, y: 320, scale: 0.25 },

      // ---- Row 4 (y ~ 440) ----
      { src: "book46.png", x: 20,  y: 440, scale: 0.25 },
      { src: "book48.png", x: 90,  y: 440, scale: 0.25 },
      { src: "book49.png", x: 160, y: 440, scale: 0.25 },
      { src: "book50.png", x: 230, y: 440, scale: 0.25 },
      { src: "book51.png", x: 300, y: 440, scale: 0.25 },
      { src: "book52.png", x: 370, y: 440, scale: 0.25 },
      { src: "book53.png", x: 440, y: 440, scale: 0.25 },
      { src: "book55.png", x: 510, y: 440, scale: 0.25 },
      { src: "book56.png", x: 580, y: 440, scale: 0.25 },
      { src: "book57.png", x: 650, y: 440, scale: 0.25 },
      { src: "book58.png", x: 720, y: 440, scale: 0.25 },
    ];

    // ================================================================
    //  🚀  BUILD THE BOOKSHELF  (you don't need to edit below)
    // ================================================================
    const shelf = document.getElementById('bookshelf');

    booksData.forEach(book => {
      const img = document.createElement('img');
      img.className = 'book';
      img.src = book.src;
      img.alt = book.src;
      // Apply position & scale
      img.style.left = book.x + 'px';
      img.style.top = book.y + 'px';
      img.style.transform = `scale(${book.scale})`;
      shelf.appendChild(img);
    });
  </script>
</body>
</html>
